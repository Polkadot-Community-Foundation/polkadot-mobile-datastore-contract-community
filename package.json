{
  "name": "account-data-store-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Permissionless per-account key-value store for coinage installation ids on pallet-revive (PolkaVM)",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "hardhat compile",
    "build:pvm": "hardhat compile --network localNode",
    "check:bytecode": "node scripts/check-bytecode.js",
    "test": "hardhat test",
    "test:guard": "mocha test/key-guard.test.js",
    "test:pvm": "hardhat test --network localNode",
    "test:revm": "hardhat test --network localNodeEvm",
    "e2e:substrate": "hardhat run scripts/substrate-e2e.js --network localNode",
    "abi": "hardhat compile && node scripts/export-abi.js",
    "deploy:substrate": "node scripts/deploy-substrate.js",
    "deploy:eth-rpc": "node scripts/deploy-eth-rpc.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "rehearse:fork": "bash scripts/rehearse-fork.sh",
    "deploy:alice": "node scripts/deploy-alice.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@parity/hardhat-polkadot": "^0.3.0",
    "@polkadot/api": "^16.5.6",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "dotenv": "^17.4.2",
    "hardhat": "^2.29.1"
  }
}
