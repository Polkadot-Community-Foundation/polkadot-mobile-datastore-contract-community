# Copy to .env (git-ignored) or export in your shell. Never commit real keys.

# scripts/deploy-substrate.js: BIP-39 passphrase of the sr25519 deployer (validated before use).
DEPLOYER_MNEMONIC=
# Optional derivation appended to it, e.g. //deploy.
# DEPLOYER_DERIVATION=
# Fallback when DEPLOYER_MNEMONIC is unset: any sr25519 secret URI. Also overrides //Alice in deploy-alice.js.
# DEPLOYER_SURI=
# NETWORK=next  # local | next | devnet | production
SUBSTRATE_WS_URL=wss://paseo-asset-hub-next-rpc.polkadot.io

# scripts/deploy.js via hardhat ETH-RPC networks: 0x-prefixed secp256k1 private key.
DEPLOYER_PRIVATE_KEY=

# Optional overrides.
# PASEO_NEXT_ETH_RPC_URL=https://eth-rpc-paseo-next.polkadot.io
# LOCAL_ETH_RPC_URL=http://127.0.0.1:8545
# LOCAL_SUBSTRATE_WS_URL=ws://127.0.0.1:9944
# RESOLC_PATH=/path/to/resolc
